<Window x:Class="OwaDesktopCleaner.EwsLoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EWS 로그인" Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F5F7FA">
<StackPanel Margin="24">
<TextBlock x:Name="Heading" Text="EWS 로그인" FontSize="22" FontWeight="Bold"/>
<TextBlock Text="https://mail.apsfamily.com/EWS/Exchange.asmx" Margin="0,10,0,18" TextWrapping="Wrap"/>
<TextBlock Text="사용자 이름"/><TextBox x:Name="UserNameBox" Margin="0,6,0,14" Padding="8"/>
<TextBlock Text="비밀번호"/><PasswordBox x:Name="PasswordInput" Margin="0,6,0,14" Padding="8"/>
<CheckBox x:Name="SaveOnPc" Content="이 PC에 저장" Margin="0,0,0,10"/>
<TextBlock Text="선택하면 현재 Windows 사용자의 자격 증명 관리자에 저장합니다. OWA 로그인 입력값은 가져오지 않습니다." TextWrapping="Wrap" Foreground="#536174"/>
<TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,12,0,12" Foreground="#984314"/>
<WrapPanel HorizontalAlignment="Right">
<Button Content="저장 정보 삭제" Click="DeleteSaved" Padding="10,7" Margin="0,0,8,8"/>
<Button x:Name="AcceptButton" Content="로그인" Click="Accept" IsDefault="True" Padding="18,7" Margin="0,0,8,8"/>
<Button Content="취소" IsCancel="True" Padding="12,7" Margin="0,0,0,8"/>
</WrapPanel>
</StackPanel>
</Window>
