<UserControl x:Class="OwaMailCleaner.Controls.OwaCalendar" x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyDown="CalendarKeyDown">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Tokens.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="DayButton" TargetType="Button"><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#F1F7FC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#0F6CBD"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </ResourceDictionary></UserControl.Resources>
  <Border BorderBrush="{StaticResource OwaBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Background="White">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Button Grid.Column="0" Content="‹" Click="PreviousMonth" FontSize="20" BorderThickness="0" Background="Transparent"/><TextBlock Grid.Column="1" Text="{Binding DisplayMonthText, ElementName=root}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="2" Content="›" Click="NextMonth" FontSize="20" BorderThickness="0" Background="Transparent"/></Grid>
      <UniformGrid Grid.Row="1" Columns="7" Margin="0,10,0,3"><TextBlock Text="일" TextAlignment="Center" Foreground="#667085"/><TextBlock Text="월" TextAlignment="Center" Foreground="#667085"/><TextBlock Text="화" TextAlignment="Center" Foreground="#667085"/><TextBlock Text="수" TextAlignment="Center" Foreground="#667085"/><TextBlock Text="목" TextAlignment="Center" Foreground="#667085"/><TextBlock Text="금" TextAlignment="Center" Foreground="#667085"/><TextBlock Text="토" TextAlignment="Center" Foreground="#667085"/></UniformGrid>
      <ItemsControl Grid.Row="2" ItemsSource="{Binding Days, ElementName=root}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource DayButton}" Content="{Binding DayText}" IsEnabled="{Binding IsEnabled}" Background="{Binding Background}" Foreground="{Binding Foreground}" ToolTip="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Tag="{Binding}" Click="SelectDay"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Grid>
  </Border>
</UserControl>
