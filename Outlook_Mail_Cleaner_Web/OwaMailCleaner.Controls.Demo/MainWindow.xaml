<Window 
    x:Class="OwaMailCleaner.Controls.Demo.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:owa="clr-namespace:OwaMailCleaner.Controls;assembly=OwaMailCleaner.Controls" Title="OWA 메일 클리너 UI 갤러리" Width="1080" Height="820" Background="#F7F9FC" FontFamily="Segoe UI, Malgun Gothic">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="OWA 메일 클리너 UI" FontSize="26" FontWeight="Bold" Foreground="#172033"/><TextBlock Text="WPF 재사용 컴포넌트 갤러리" Margin="0,4,0,22" Foreground="#667085"/>
    <WrapPanel Margin="0,0,0,16"><owa:OwaButton Content="대상 메일 검색" Margin="0,0,8,0"/><owa:OwaButton Content="선택 해제" Variant="Secondary" Margin="0,0,8,0"/><owa:OwaButton Content="휴지통 이동" Variant="Danger" Margin="0,0,8,0"/><owa:OwaButton Content="비활성" IsEnabled="False"/></WrapPanel>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><owa:OwaComboBox Label="폴더" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"/><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="처리 방식" FontWeight="SemiBold" Margin="0,0,0,5"/><WrapPanel><owa:OwaRadioButton GroupName="mode" Content="첨부파일 삭제"/><owa:OwaRadioButton GroupName="mode" Content="읽음 처리" IsChecked="True" Margin="8,0,0,0"/><owa:OwaRadioButton GroupName="mode" Content="휴지통 이동" Margin="8,0,0,0"/></WrapPanel></StackPanel></Grid>
    <owa:OwaSeparator Margin="0,0,0,18"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="검색 결과: 3" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><owa:OwaDataGrid ItemsSource="{Binding Messages}" Height="250"><DataGrid.Columns><DataGridTextColumn Header="수신일" Binding="{Binding Received, StringFormat={}{0:yyyy-MM-dd}}" Width="130"/><DataGridTextColumn Header="발신자" Binding="{Binding Sender}" Width="150"/><DataGridTextColumn Header="제목" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></owa:OwaDataGrid></StackPanel><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="날짜 범위" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><owa:OwaCalendar SelectionMode="Range" RangeStart="{Binding StartDate}" RangeEnd="{Binding EndDate}" MinDate="{Binding MinimumDate}" DisabledDates="{Binding DisabledDates}"/><TextBlock Margin="0,8,0,0" Text="{Binding RangeText}" Foreground="#667085"/></StackPanel></Grid>
  </StackPanel></ScrollViewer>
</Window>
