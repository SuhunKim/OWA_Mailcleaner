<Window x:Class="MailCleaner.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MailCleaner.Views" xmlns:models="clr-namespace:MailCleaner.Models" mc:Ignorable="d"
        Title="메일 클리너 · WPF" Icon="/OwaMailCleaner.Wpf;component/Assets/window-icon.png" Width="1100" Height="760" MinWidth="760" MinHeight="640" ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        Background="White" FontFamily="Segoe UI, Malgun Gothic" FontSize="14" Foreground="#172033" Language="ko-KR" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CleanerTheme.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style TargetType="CheckBox" BasedOn="{StaticResource CleanerCheckBox}"/><BooleanToVisibilityConverter x:Key="BoolVisibility"/><local:ModeSelectionConverter x:Key="ModeSelection"/><local:StatusColorConverter x:Key="StatusColor"/><local:FilterHeightConverter x:Key="FilterHeight"/><DataTemplate x:Key="FolderOption"><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/></DataTemplate><DataTemplate x:Key="SortOption"><TextBlock Text="{Binding Label}"/></DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="ClientLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,16">
          <StackPanel>
            <DockPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="메일 클리너" FontSize="20" FontWeight="Bold"/><TextBlock Text="WPF · 사내 Exchange" Style="{StaticResource MutedText}" Margin="12,5,0,0"/></StackPanel>
            </DockPanel>
            <WrapPanel Margin="0,12,0,0">
              <Button Style="{StaticResource CleanerButton}" Content="Windows 계정으로 연결" Command="{Binding ConnectCommand}" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
              <Button Style="{StaticResource CleanerButton}" Content="EWS 로그인 정보" Command="{Binding LoginCommand}" Padding="10,5" FontSize="12" Margin="0,0,16,0"/>
              <CheckBox Content="변경 작업 허용" IsChecked="{Binding AllowChanges}" IsEnabled="{Binding CanChangePermission}" VerticalAlignment="Center" FontSize="12"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Grid x:Name="BodyLayout" Grid.Row="1" Margin="20,18,20,18" ClipToBounds="True">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="FiltersViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.MaxHeight><MultiBinding Converter="{StaticResource FilterHeight}"><Binding Path="ActualHeight" ElementName="BodyLayout"/><Binding Path="ActualHeight" ElementName="ResultToolbar"/><Binding Path="Margin" ElementName="ResultToolbar"/></MultiBinding></ScrollViewer.MaxHeight>
          <StackPanel>
            <Grid IsEnabled="{Binding Idle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0"><TextBlock Text="폴더" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource CleanerComboBox}" ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" ItemTemplate="{StaticResource FolderOption}" IsEnabled="{Binding CanChooseFolder}" ToolTip="{Binding Folder.Path}"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="제목 키워드" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource CleanerTextBox}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/></StackPanel>
              <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="시작일" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="StartPicker" Style="{StaticResource CleanerDatePicker}" SelectedDate="{Binding Start}"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="종료일" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="EndPicker" Style="{StaticResource CleanerDatePicker}" SelectedDate="{Binding End}"/></StackPanel>
            </Grid>
            <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding Idle}" AutomationProperties.Name="처리 방식">
              <RadioButton Style="{StaticResource ModeChip}" Content="조회만 (실행 안 함)" GroupName="CleanupMode" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeSelection}, ConverterParameter={x:Static models:CleanupMode.Inspect}}"/>
              <RadioButton Style="{StaticResource ModeChip}" Content="일반 첨부파일 삭제" GroupName="CleanupMode" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeSelection}, ConverterParameter={x:Static models:CleanupMode.RemoveAttachments}}"/>
              <RadioButton Style="{StaticResource ModeChip}" Content="읽음 처리" GroupName="CleanupMode" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeSelection}, ConverterParameter={x:Static models:CleanupMode.MarkRead}}"/>
              <RadioButton Style="{StaticResource ModeChip}" Content="휴지통 이동" GroupName="CleanupMode" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeSelection}, ConverterParameter={x:Static models:CleanupMode.MoveToDeleted}}"/>
              <RadioButton Style="{StaticResource ModeChip}" Content="휴지통 정리" GroupName="CleanupMode" IsEnabled="{Binding CanEmptyDeleted}" IsChecked="{Binding SelectedMode, Converter={StaticResource ModeSelection}, ConverterParameter={x:Static models:CleanupMode.EmptyDeleted}}"/>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
              <Button Style="{StaticResource PrimaryButton}" Content="대상 메일 검색" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
              <Button Style="{StaticResource CleanerButton}" Content="중단 요청" Command="{Binding StopCommand}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding SearchHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="740"/>
            </WrapPanel>
            <Border Margin="0,14,0,0" CornerRadius="9" Padding="12,10" Background="{Binding Status, Converter={StaticResource StatusColor}}"><TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusColor}, ConverterParameter=Foreground}" TextWrapping="Wrap" d:Text="EWS 연결을 먼저 완료해 주세요."/></Border>
            <Border CornerRadius="3" Margin="0,9,0,0" Background="#DBE7F3" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"><ProgressBar Height="6" BorderThickness="0" Foreground="#0F6CBD" Background="Transparent" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}"/></Border>
          </StackPanel>
          </ScrollViewer>
            <DockPanel x:Name="ResultToolbar" Grid.Row="1" Margin="0,16,0,9" LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource CleanerButton}" Content="전체 선택" Command="{Binding SelectAllCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource CleanerButton}" Content="선택 해제" Command="{Binding ClearSelectionCommand}"/></StackPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="정렬" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox Style="{StaticResource CleanerComboBox}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" ItemTemplate="{StaticResource SortOption}" Width="154" Height="36" IsEnabled="{Binding Idle}"/></StackPanel>
              <TextBlock Text="{Binding ResultCountSummary}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
            </DockPanel>
            <Border x:Name="ResultsFrame" Grid.Row="2" BorderBrush="#DFE4EA" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
              <Grid>
                <DataGrid x:Name="MailGrid" ItemsSource="{Binding Mails}" Style="{StaticResource CleanerGrid}" IsEnabled="{Binding Idle}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Sorting="SortMailGrid">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="선택" Width="48" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="메일 선택"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="수신일" Binding="{Binding ReceivedDisplay}" SortMemberPath="Received" Width="145" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="발신자" Width="172" SortMemberPath="Sender"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Sender}" TextWrapping="Wrap"/><TextBlock Text="{Binding SenderAddressDisplay}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SenderAddress}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="제목" Binding="{Binding Subject}" Width="*" MinWidth="220" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                    <DataGridTextColumn Header="상태" Binding="{Binding ReadDisplay}" Width="70" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsRead}" Value="False"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                    <DataGridTextColumn Header="메일 용량" Binding="{Binding SizeDisplay}" SortMemberPath="Size" Width="88" IsReadOnly="True"/>
                    <DataGridTextColumn Header="일반 첨부" Binding="{Binding AttachmentDisplay}" Width="160" IsReadOnly="True" CanUserSort="False"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding EmptyMessage}" Margin="0,52,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Mails.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Grid>
            </Border>
        </Grid>
        <Expander Grid.Row="2" Header="최근 처리 결과 · 펼치기/접기" IsExpanded="{Binding ReportExpanded}" Visibility="{Binding ReportVisible, Converter={StaticResource BoolVisibility}}" Margin="20,0,20,12" FontSize="12"><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/><DataGrid ItemsSource="{Binding Results}" Style="{StaticResource CleanerGrid}" IsReadOnly="True" MaxHeight="150"><DataGrid.Columns><DataGridTextColumn Header="제목" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="결과" Binding="{Binding Label}" Width="100"/><DataGridTextColumn Header="설명" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
        <Border x:Name="FooterBar" Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionSummary}" Foreground="#475467" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding ExecutionDisabledReason}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource CleanerButton}" Content="닫기" Click="CloseWindow" IsEnabled="{Binding Idle}" Margin="0,0,8,0"/><Button Content="{Binding ExecuteLabel}" Command="{Binding ExecuteCommand}" ToolTip="{Binding ExecutionDisabledReason}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedMode}" Value="{x:Static models:CleanupMode.EmptyDeleted}"><Setter Property="Background" Value="#D92D20"/><Setter Property="BorderBrush" Value="#D92D20"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
          </Grid>
        </Border>
  </Grid>
</Window>
