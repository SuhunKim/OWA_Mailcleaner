<Window x:Class="MailCleaner.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        Title="OWA MailCleaner · WPF" Icon="/OwaMailCleaner.Wpf;component/Assets/window-icon.png" Width="1240" Height="850" MinWidth="1000" MinHeight="680" Background="#F3F6FA" FontFamily="Malgun Gothic">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="메일 클리너" FontSize="27" FontWeight="SemiBold" Foreground="#162E4A"/>
      <TextBlock Text="WPF  /  회사 EWS · 날짜 기준: 한국시간" Foreground="#62758B" Margin="0,4,0,18"/>
      <WrapPanel Margin="0,0,0,16">
        <Button Content="현재 Windows 계정으로 연결" Command="{Binding ConnectCommand}"/>
        <Button Content="다른 EWS 계정으로 연결" Command="{Binding LoginCommand}"/>
        <CheckBox Content="변경 작업 허용" IsChecked="{Binding AllowChanges}" IsEnabled="{Binding CanChangePermission}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </WrapPanel>
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,12,12" IsEnabled="{Binding Idle}"><TextBlock Text="폴더" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" DisplayMemberPath="Path" d:SelectedIndex="0"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,12" IsEnabled="{Binding Idle}"><TextBlock Text="제목 키워드" Margin="0,0,0,5"/><TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,12,12" IsEnabled="{Binding Idle}"><TextBlock Text="시작일" Margin="0,0,0,5"/><DatePicker x:Name="StartPicker" SelectedDate="{Binding Start}"/></StackPanel>
        <StackPanel Grid.Column="3" Margin="0,0,0,12" IsEnabled="{Binding Idle}"><TextBlock Text="종료일 (포함)" Margin="0,0,0,5"/><DatePicker x:Name="EndPicker" SelectedDate="{Binding End}"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,12,0" IsEnabled="{Binding Idle}"><TextBlock Text="처리 방식 · 방식을 바꾼 뒤 다시 검색하세요" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" DisplayMemberPath="Label"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="검색" Command="{Binding SearchCommand}"/><Button Content="중단 요청" Command="{Binding StopCommand}"/></StackPanel>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="휴지통 정리는 지운 편지함에서 검색·선택한 메일을 SoftDelete로 처리합니다." Foreground="#62758B" Margin="0,12,0,0"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Button Content="전체 선택" Command="{Binding SelectAllCommand}"/><Button Content="선택 해제" Command="{Binding ClearSelectionCommand}"/></StackPanel><TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Mails}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" EnableRowVirtualization="True" IsEnabled="{Binding Idle}" RowHeaderWidth="0" GridLinesVisibility="Horizontal" Background="White" BorderBrush="#DDE5EF" HeadersVisibility="Column" SelectionMode="Extended">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="선택" Width="50" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="받은 날짜 (KST) ↕" Binding="{Binding ReceivedDisplay}" SortMemberPath="Received" Width="165" IsReadOnly="True"/>
          <DataGridTextColumn Header="제목" Binding="{Binding Subject}" Width="*" MinWidth="200" IsReadOnly="True"/>
          <DataGridTextColumn Header="보낸 사람" Binding="{Binding Sender}" Width="150" IsReadOnly="True"/>
          <DataGridTextColumn Header="용량 ↕" Binding="{Binding SizeDisplay}" SortMemberPath="Size" Width="105" IsReadOnly="True"/>
          <DataGridCheckBoxColumn Header="읽음" Binding="{Binding IsRead, Mode=OneWay}" IsReadOnly="True" Width="50"/>
          <DataGridTextColumn Header="일반 첨부*" Binding="{Binding RemovableCount}" Width="80" IsReadOnly="True"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="* 일반 첨부 수는 ‘일반 첨부 삭제’ 검색에서 상세 조회합니다. 날짜·용량 열 제목을 눌러 정렬하세요." FontSize="11" Foreground="#62758B" Margin="0,0,0,8"/>
      <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,10" d:Text="연결 전 · 검색 조건과 처리 방식을 선택하세요"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="선택 항목 실행…" Command="{Binding ExecuteCommand}"/><TextBlock Text="{Binding ExecutionDisabledReason}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#7A5425" Margin="0,0,12,0"/></DockPanel>
    </StackPanel>
    <Expander Grid.Row="4" Header="최근 처리 결과" IsExpanded="{Binding ReportExpanded}" Visibility="{Binding ReportVisible, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0" Background="#E8EEF6">
      <StackPanel Margin="10"><TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/><DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150"><DataGrid.Columns><DataGridTextColumn Header="제목" Binding="{Binding Subject}" Width="*"/><DataGridTextColumn Header="결과" Binding="{Binding Label}" Width="100"/><DataGridTextColumn Header="설명" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid></StackPanel>
    </Expander>
  </Grid>
</Window>

