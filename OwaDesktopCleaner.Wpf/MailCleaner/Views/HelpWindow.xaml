<Window x:Class="MailCleaner.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="메일 클리너 · 사용 방법" Icon="/OwaMailCleaner.Wpf;component/Assets/window-icon.png"
        Width="700" Height="740" MinWidth="540" MinHeight="460" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="White" Foreground="#172033" FontFamily="Segoe UI, Malgun Gothic"
        FontSize="14" Language="ko-KR" KeyDown="CloseOnEscape">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CleanerTheme.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style x:Key="Step" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="LineHeight" Value="23"/></Style>
      <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Step}"><Setter Property="Foreground" Value="#667085"/><Setter Property="FontSize" Value="12"/></Style>
      <Style TargetType="Expander"><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
      <Style x:Key="Steps" TargetType="StackPanel"><Setter Property="Margin" Value="22,12,0,0"/><Setter Property="TextElement.FontWeight" Value="Normal"/></Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="24,20" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><StackPanel>
      <TextBlock Text="메일 클리너 사용 방법" FontSize="21" FontWeight="Bold"/>
      <TextBlock Text="항목을 펼쳐 클릭·입력 순서를 확인하세요. 이 창을 열어둔 채 메인 화면에서 작업할 수 있습니다." Style="{StaticResource Note}" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
      <StackPanel>
        <Border Background="#EFF6FF" CornerRadius="9" Padding="14" Margin="0,0,0,20"><StackPanel>
          <TextBlock Text="먼저 회사 메일에 연결해 주세요" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="회사 계정으로 연결 → 회사에서 안내한 계정 형식과 비밀번호 입력 → 연결을 누릅니다. 현재 Windows 계정으로 접속할 때는 Windows 계정으로 연결을 사용합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="연결 성공과 폴더 목록을 확인하세요. 실제 메일을 변경하려면 변경 작업 허용이 체크돼 있어야 합니다. 기본 처리 방식은 조회만입니다." Style="{StaticResource Step}" Margin="0"/>
        </StackPanel></Border>
        <Expander Header="1. 메일 읽음 처리하기" IsExpanded="True"><StackPanel Style="{StaticResource Steps}">
          <TextBlock Text="① 폴더를 선택하고 제목 키워드, 시작일·종료일을 입력합니다. 제목 키워드는 비워둘 수 있습니다." Style="{StaticResource Step}"/>
          <TextBlock Text="② 처리 방식에서 읽음 처리를 선택합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="③ 대상 메일 검색을 누르고 목록에서 대상 메일을 확인합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="④ 왼쪽 체크박스로 메일을 선택합니다. 전체 선택은 검색된 목록 전체를 선택합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="⑤ 선택 항목 실행을 누릅니다. 최종 확인 창에서 폴더·작업·건수를 확인한 뒤 예를 누릅니다." Style="{StaticResource Step}"/>
          <TextBlock Text="⑥ 상태와 최근 처리 결과를 확인합니다. 필요하면 다시 검색해 서버의 읽음 상태를 확인하세요." Style="{StaticResource Step}"/>
          <TextBlock Text="이미 읽은 메일은 건너뜁니다. 읽음 확인 전송 억제 옵션을 사용합니다." Style="{StaticResource Note}"/>
        </StackPanel></Expander>
        <Expander Header="2. 일반 첨부파일 삭제하기"><StackPanel Style="{StaticResource Steps}">
          <TextBlock Text="① 폴더·제목 키워드·검색 기간을 입력하고 일반 첨부파일 삭제를 선택합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="② 대상 메일 검색을 누릅니다. 일반 첨부 열에서 처리 대상 첨부 정보를 확인하세요." Style="{StaticResource Step}"/>
          <TextBlock Text="③ 첨부를 삭제할 메일을 체크하고 선택 항목 실행을 누릅니다. 개별 첨부가 아닌 메일 단위로 대상을 선택합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="④ 최종 확인 후 예를 누르면 선택한 메일의 처리 가능한 일반 첨부를 삭제합니다. 메일 본문은 남습니다." Style="{StaticResource Step}"/>
          <TextBlock Text="⑤ 최근 처리 결과를 펼쳐 성공·실패·건너뜀을 확인하고 필요하면 다시 검색합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="첨부 삭제는 취소할 수 없습니다. 필요한 파일은 먼저 별도로 보관하세요. 인라인 이미지·본문 연결 첨부·항목 첨부 등 보존 대상은 제외하며, 검색 당시와 실행 직전에 모두 확인된 일반 첨부만 처리합니다." Style="{StaticResource Note}"/>
        </StackPanel></Expander>
        <Expander Header="3. 메일을 휴지통으로 이동하기"><StackPanel Style="{StaticResource Steps}">
          <TextBlock Text="① 이동할 메일이 있는 폴더와 검색 조건을 입력하고 휴지통 이동을 선택합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="② 대상 메일 검색 → 대상 메일 체크 → 선택 항목 실행 순서로 누릅니다." Style="{StaticResource Step}"/>
          <TextBlock Text="③ 최종 확인 창의 폴더와 건수를 확인하고 예를 누릅니다. 결과 확인 후 지운 편지함에서 다시 조회할 수 있습니다." Style="{StaticResource Step}"/>
        </StackPanel></Expander>
        <Expander Header="4. 휴지통 정리하기"><StackPanel Style="{StaticResource Steps}">
          <TextBlock Text="① 휴지통 정리를 선택합니다. 폴더가 지운 편지함으로 바뀌고 제목 키워드는 비워집니다. 검색 기간을 다시 확인하세요." Style="{StaticResource Step}"/>
          <TextBlock Text="② 대상 메일 검색을 눌러 지운 편지함 바로 아래의 일반 메일을 조회합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="③ 정리할 메일을 체크하고 선택 항목 비우기를 누른 뒤 최종 확인합니다. 검색·선택한 메일만 처리합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="SoftDelete 방식이며 복구 가능 여부와 보존 기간은 회사 서버 정책을 따릅니다. 휴지통 전체나 하위 폴더를 한 번에 비우는 기능은 아닙니다." Style="{StaticResource Note}"/>
        </StackPanel></Expander>
        <Expander Header="5. 조회·선택·정렬 및 중단"><StackPanel Style="{StaticResource Steps}">
          <TextBlock Text="조회만: 메일을 변경하지 않고 검색합니다. 이 모드에서는 실행 버튼이 비활성화됩니다." Style="{StaticResource Step}"/>
          <TextBlock Text="검색 기간: 종료일은 해당 날짜 23:59:59까지 포함합니다. 검색은 선택한 폴더를 대상으로 합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="선택·정렬: 전체 선택 / 선택 해제로 체크를 바꾸고, 정렬 메뉴나 수신일·메일 용량 열 제목으로 정렬합니다. 선택 건수와 용량은 하단에 표시됩니다." Style="{StaticResource Step}"/>
          <TextBlock Text="다시 검색: 검색 조건이나 처리 방식을 바꾸면 기존 선택으로 실행할 수 없습니다. 처리 방식을 먼저 고른 뒤 다시 검색하고 대상을 선택하세요." Style="{StaticResource Step}"/>
          <TextBlock Text="중단 요청: 현재 전송한 변경 작업을 되돌리지 않습니다. 전송한 작업의 응답을 확인한 뒤 나머지를 멈춥니다." Style="{StaticResource Step}"/>
          <TextBlock Text="처리 결과: 최근 처리 결과를 펼쳐 성공·실패·건너뜀·결과 미확인·미처리를 구분합니다. 새 검색을 시작하면 이전 결과 영역은 숨겨집니다." Style="{StaticResource Step}"/>
          <TextBlock Text="결과 미확인은 자동 재시도하지 않습니다. 먼저 다시 조회해 서버 상태를 확인하세요. 실행할 수 없는 이유는 메인 화면 하단에도 표시됩니다." Style="{StaticResource Note}"/>
        </StackPanel></Expander>
        <Expander Header="6. 연결에 실패할 때"><StackPanel Style="{StaticResource Steps}">
          <TextBlock Text="① 회사가 안내한 계정 형식(도메인\계정 또는 계정@회사도메인)과 사내망·VPN 등 필요한 접속 조건을 확인합니다." Style="{StaticResource Step}"/>
          <TextBlock Text="② 실패 안내 아래의 연결 진단 정보를 펼쳐 진단 정보 복사를 누릅니다." Style="{StaticResource Step}"/>
          <TextBlock Text="③ 서버 연결 진단을 누른 뒤 새 진단 정보도 복사해 담당자에게 함께 전달합니다. 비밀번호는 보내지 마세요." Style="{StaticResource Step}"/>
          <TextBlock Text="익명 진단의 HTTP 401은 서버가 인증을 요구한다는 뜻이며 로그인 성공은 아닙니다. OWA 접속과 EWS 허용 정책은 다를 수 있습니다. 인증이 만료되면 다시 연결해야 변경할 수 있습니다." Style="{StaticResource Note}"/>
        </StackPanel></Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="24,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"><Button x:Name="HelpCloseButton" Content="닫기" Style="{StaticResource CleanerButton}" HorizontalAlignment="Right" Click="CloseWindow" ToolTip="Esc"/></Border>
  </Grid>
</Window>
